{
  "name": "springus-pl",
  "version": "1.0.0",
  "private": true,
  "description": "springus.pl — strona i oferta freelancera: tworzenie stron internetowych",
  "scripts": {
    "dev": "wrangler pages dev public",
    "preview": "python3 -m http.server 4173 --directory public",
    "validate": "html-validate \"public/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "test": "npm run validate && npm run check:links && npm run check:jsonld",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "html-validate": "^9.7.1",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=22"
  }
}
